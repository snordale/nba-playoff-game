# Database
DATABASE_URL="your-database-url"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Invite links (JWT)
JWT_INVITE_SECRET="your-super-strong-random-secret-key-here"

# Cron (Bearer token for /api/cron/*)
CRON_SECRET="your-cron-secret"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin: comma-separated emails allowed to access /admin and admin APIs (or use ADMIN_EMAIL for a single email)
ADMIN_EMAIL="admin@example.com"
# ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# Optional: base URL for server-side API calls (e.g. axios). Client uses relative URLs.
# API_URL="http://localhost:3000"
